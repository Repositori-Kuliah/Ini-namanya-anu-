{
  "name": "rawon-gusti-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@rawon-gusti/frontend",
    "dev:backend": "npm run dev --workspace=@rawon-gusti/backend",
    "build": "npm run build --workspace=@rawon-gusti/frontend",
    "build:all": "npm run build --workspaces",
    "preview": "npm run preview --workspace=@rawon-gusti/frontend",
    "lint": "npm run lint --workspace=@rawon-gusti/frontend",
    "test": "node supabase/tests/security_and_lifecycle.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
